{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Look On — core, sql, http.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:resources:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://invidious.fdn.fr/*" },
        { "url": "https://inv.tux.pizza/*" },
        { "url": "https://yewtu.be/*" },
        { "url": "https://invidious.nerdvpn.de/*" },
        { "url": "https://iv.ggtyler.dev/*" },
        { "url": "https://i.ytimg.com/*" },
        { "url": "https://api.dicebear.com/*" }
      ]
    }
  ]
}
